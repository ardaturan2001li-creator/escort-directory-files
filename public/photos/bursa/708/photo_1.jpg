    .btn-card-wa { background: var(--accent-wa); color: #fff; padding: 7px; border-radius: 6px; font-size: 11px; font-weight: 700; text-align: center; display: flex; align-items: center; justify-content: center; }

    /* SEO Zengin İçerik & Silo Bağlantı Kutusu */
    .seo-rich-box { background: var(--bg-card); border: 1px solid var(--border-gold); border-radius: 14px; padding: 26px; margin-top: 30px; }
    .seo-rich-h2 { font-family: 'Cinzel', serif; font-size: 20px; color: var(--gold-primary); margin-bottom: 14px; font-weight: 800; border-bottom: 1px solid rgba(212,175,55,0.2); padding-bottom: 8px; }
