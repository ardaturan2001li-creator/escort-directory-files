  <style amp-custom>
    :root {
      --bg-dark: #0a0a0c;
      --bg-card: #13151b;
      --bg-elevated: #1b1f28;
      --gold-primary: #d4af37;
      --gold-light: #f5cf68;
      --gold-dark: #996515;
      --silver-primary: #d1d5db;
      --bronze-primary: #cd7f32;
      --text-main: #f5f5f7;
      --text-muted: #9aa1b0;
      --text-dim: #cbd5e1;
      --border-color: rgba(255, 255, 255, 0.08);
      --border-gold: rgba(212, 175, 55, 0.4);
      --accent-wa: #25d366;
      --accent-tg: #229ed9;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-dark); color: var(--text-main); font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1.5; padding-bottom: 40px; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
