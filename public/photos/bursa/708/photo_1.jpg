    .brand-title span { color: #fff; }
    .btn-back { background: var(--bg-card); border: 1px solid var(--border-gold); color: var(--gold-light); padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px; }
    .menu-btn { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 6px 12px; border-radius: 6px; font-size: 14px; cursor: pointer; }

    .hero-banner { padding: 26px 16px 18px 16px; background: linear-gradient(180deg, rgba(212, 175, 55, 0.08) 0%, rgba(10, 10, 12, 0) 100%); text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .hero-pill { display: inline-block; background: rgba(212, 175, 55, 0.15); border: 1px solid var(--gold-primary); color: var(--gold-primary); padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing: 1px; margin-bottom: 10px; }
    .hero-h1 { font-family: 'Cinzel', serif; font-size: 23px; font-weight: 800; color: #ffffff; margin-bottom: 8px; }
    .hero-h1 span { color: var(--gold-primary); }
    .hero-desc { font-size: 13px; color: var(--text-muted); max-width: 620px; margin: 0 auto; }

    /* Alt Semt Çipleri (İç Linkleme & Gezinti) */
    .subdistricts-nav { display: flex; gap: 8px; overflow-x: auto; padding: 12px 16px; background: #0d0f14; border-bottom: 1px solid var(--border-color); -webkit-overflow-scrolling: touch; }
    .subdistricts-nav::-webkit-scrollbar { display: none; }
    .sub-nav-chip { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .sub-nav-chip.active { background: var(--gold-primary); color: #000; border-color: var(--gold-primary); font-weight: 800; }

    .catalog-container { max-width: 1200px; margin: 0 auto; padding: 20px 16px; }
    .grid-models { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; margin-bottom: 36px; }

    .model-card { background: var(--bg-card); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); display: flex; flex-direction: column; position: relative; }
    .card-gold { border-color: var(--border-gold); }
    .card-silver { border-color: rgba(209, 213, 219, 0.3); }
    .card-bronze { border-color: rgba(205, 127, 50, 0.3); }

    .card-media { position: relative; background: #000; display: block; overflow: hidden; }
    .card-badge-topleft { position: absolute; top: 10px; left: 10px; z-index: 5; }
    .card-badge-topright { position: absolute; top: 10px; right: 10px; z-index: 5; }
    .card-badge-bottom { position: absolute; bottom: 8px; right: 8px; z-index: 5; background: rgba(0, 0, 0, 0.72); backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, 0.15); color: #fff; font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 6px; display: flex; align-items: center; gap: 6px; }
    .card-badge-bottom .verified-dot { color: #22c55e; font-weight: 800; }

    .badge-nationality { background: rgba(10, 15, 30, 0.85); backdrop-filter: blur(6px); border: 1px solid rgba(96, 165, 250, 0.5); color: #bfdbfe; font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.5); letter-spacing: 0.3px; }
    .badge-tier-gold { background: linear-gradient(135deg, var(--gold-primary), var(--gold-dark)); color: #000; font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 6px; box-shadow: 0 2px 10px rgba(212, 175, 55, 0.35); letter-spacing: 0.3px; }
    .badge-tier-silver { background: linear-gradient(135deg, #e5e7eb, #9ca3af); color: #000; font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 6px; box-shadow: 0 2px 10px rgba(209, 213, 219, 0.3); letter-spacing: 0.3px; }
    .badge-tier-bronze { background: linear-gradient(135deg, #cd7f32, #78350f); color: #fff; font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 6px; letter-spacing: 0.3px; }

    .card-tags-row { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; }
    .chip-srv { background: rgba(212, 175, 55, 0.12); color: var(--gold-light); font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(212, 175, 55, 0.2); }
    .chip-phys { background: rgba(255, 255, 255, 0.06); color: var(--text-muted); font-size: 10px; padding: 2px 6px; border-radius: 4px; }
    .card-body { padding: 12px; display: flex; flex-direction: column; gap: 8px; }
